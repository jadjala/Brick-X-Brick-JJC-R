# Copy to .env (in this folder or in supabase/) and fill from the Supabase dashboard.
# Service-role key is secret — never commit the real .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; not required by the seed (it uses the service-role client), but kept
# for parity with `supabase db push` / direct psql usage.
DATABASE_URL=
