# Copy to .env. Expo only exposes vars prefixed EXPO_PUBLIC_* to the app bundle.
# On a physical device, EXPO_PUBLIC_API_BASE_URL must be reachable from the phone
# (LAN IP, not localhost) — see CLAUDE.md "Common gotchas" #2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
