# Copy to .env and fill from the Supabase dashboard. Never commit the real .env.
PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional/unused: this project signs JWTs with ES256, verified via JWKS in
# lib/auth.ts. Kept only as a possible HS256 fallback. See sprint-1-verification §7.
SUPABASE_JWT_SECRET=
# Required: IPv4 session-pooler connection string (the direct db.<ref> host is
# IPv6-only). Password must be URL-encoded.
DATABASE_URL=
NODE_ENV=development
TZ=Asia/Manila
